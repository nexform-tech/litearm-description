<package format="3">
  <name>litearm_description</name>
  <version>1.0.0</version>
  <description>
    URDF Description package for litearm_description. Contains configuration data,
    3D models and launch files for the litearm 7-DOF robot.
  </description>
  <maintainer email="wuruihao@nexform.tech">NEXFORM ROBOTICS</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
